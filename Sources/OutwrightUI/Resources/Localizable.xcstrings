    "Outwright isn't allowed to use Contacts, so Save contacts to iPhone is off for these. Turn it on in the account's settings." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Outwright isn't allowed to use Contacts, so Save contacts to iPhone is off for these. Turn it on in the account's settings."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Outwright får inte använda Kontakter, så Spara kontakter på iPhone är avstängt för dessa. Slå på det i kontots inställningar."
          }
        }
      }
    },
    "The file can't be made: something in your setup is too large for it, or damaged." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The file can't be made: something in your setup is too large for it, or damaged."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filen kan inte göras: något i dina inställningar är för stort för den, eller skadat."
          }
        }
      }
    },
    "The file has a different key for %@. Use it here? This device's key stays, so older mail still opens." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The file has a different key for %@. Use it here? This device's key stays, so older mail still opens."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filen har en annan nyckel för %@. Vill du använda den på den här enheten? Den här enhetens nyckel finns kvar, så äldre mejl går fortfarande att öppna."
          }
        }
      }
    },
    "The information sent to Outwright contains no private information, no mail and no details of any account." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The information sent to Outwright contains no private information, no mail and no details of any account."
