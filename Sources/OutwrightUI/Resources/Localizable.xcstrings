        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det du redan har på den här enheten förblir som det är. Skiljer sig något får du frågan om det. Din andra enhet väntar i upp till 5 minuter. Slutar den vänta hämtas ingenting hit."
          }
        }
