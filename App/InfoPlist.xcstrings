          "stringUnit" : {
            "state" : "translated",
            "value" : "Outwright asks for Face ID before it puts your passwords and keys in a setup file."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Outwright frågar efter Face ID innan dina lösenord och nycklar läggs i en inställningsfil."
